# Copy this file to .env for local development.
# Generate a private value; never commit your real .env file.
SESSION_SECRET=replace_with_a_long_random_secret
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Optional persistent paths for production hosting:
# CNF_DATABASE_PATH=/var/data/cnf-users.db
# CNF_SESSION_DIR=/var/data/sessions
# CNF_LIBRARY_DIR=/var/data/library

# Used only for the one-time owner admin setup; keep your real value private.
OWNER_ADMIN_EMAIL=your-owner-email@example.com

# Gmail SMTP for password-reset OTP and student support email.
# Use a Google App Password, never your regular Gmail password.
GMAIL_USER=your-support-email@gmail.com
GMAIL_APP_PASSWORD=your_16_character_google_app_password

# Optional: support inbox; defaults to GMAIL_USER.
SUPPORT_EMAIL=your-support-email@gmail.com
